# From Firebase service account JSON (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value including \n line breaks kept literal (as one line, quoted)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# AI assistant (in-chat trigger + voice command parsing) — free tier, no card needed
# Get a key at https://aistudio.google.com/apikey (same Google account as Firebase)
GEMINI_API_KEY=your-gemini-api-key

# Master admin panel — reachable at /root-admin on the client from ANY device,
# gated only by this password (not tied to any user account). Pick something strong.
ROOT_ADMIN_PASSWORD=change-this-to-something-only-you-know
